# Local development defaults only. Generate a private secret key and never
# commit the resulting .env file.
DJANGO_SETTINGS_MODULE=labvault_project.settings
DJANGO_SECRET_KEY=local-development-only-change-before-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local demo database. For SQL Server/Azure SQL use DB_ENGINE=mssql and fill
# in the connection fields below. Tests always use settings_test.py + SQLite.
DB_ENGINE=sqlite
DB_AUTH_MODE=password
DB_HOST=localhost
DB_PORT=1433
DB_NAME=LabVault
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=False
DB_ENCRYPT=True
DB_TRUST_SERVER_CERTIFICATE=False

# Azure SQL configuration template. Copy these keys into the ignored local
# .env only when you intentionally want to connect to an Azure SQL database.
# Never commit .env or store real credentials in this file.
# DB_ENGINE=mssql
# DB_AUTH_MODE=password
# DB_NAME=<your-azure-sql-database>
# DB_HOST=<your-sql-server>.database.windows.net
# DB_PORT=1433
# DB_USER=<your-sql-username>
# DB_PASSWORD=<your-sql-password>
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_ENCRYPT=True
# DB_TRUST_SERVER_CERTIFICATE=False

# Keep local uploaded files outside static/ and templates/.
MEDIA_ROOT=./media
MAX_CONTENT_LENGTH=10485760

# Session settings. Secure cookies should be enabled when serving over HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=1800
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Optional Azure Blob Storage. Leave unset to use local storage.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=labvault

# Optional SMTP configuration. Defaults to console email for development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LabVault <no-reply@labvault.local>

# Optional OAuth providers. Configure only when callback URLs are registered.
# SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
# SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
# SOCIAL_AUTH_MICROSOFT_OAUTH2_KEY=
# SOCIAL_AUTH_MICROSOFT_OAUTH2_SECRET=
# SOCIAL_AUTH_GITHUB_KEY=
# SOCIAL_AUTH_GITHUB_SECRET=
